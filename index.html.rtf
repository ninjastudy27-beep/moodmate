  <!-- APPLICATION LOGIC -->\
  <script>\
    // Initialize Lucide Icons\
    lucide.createIcons();\
\
    // App State\
    let conversationHistory = [];\
    const SYSTEM_PERSONA = `\
You are MoodMate, a compassionate, emotionally intelligent, and deeply comforting therapist-friend.\
The user is venting their feelings, anxieties, grief, frustrations, or heartaches to you.\
\
Your guidelines:\
1. Be a warm, empathetic listener first. Always validate their emotions before offering any perspective.\
2. Sound like a real, understanding friend who is educated in empathetic communication, NOT a sterile textbook or corporate AI.\
3. Keep responses authentic, human-sized, and organic (avoid giant lists, bullet points, or patronizing cliches like "It is important to remember").\
4. Ask gentle, open-ended questions when appropriate to help them untangle what they are carrying.\
5. Never judge. Be a haven of calm, patience, and warmth.\
    `.trim();\
\
    // Page Switching Logic\
    function switchPage(pageId) \{\
      const pages = ['intro', 'system', 'chat'];\
      pages.forEach(p => \{\
        const pageEl = document.getElementById(`page-$\{p\}`);\
        const navBtn = document.getElementById(`nav-$\{p\}`);\
        if (p === pageId) \{\
          pageEl.classList.remove('hidden');\
          navBtn.classList.add('bg-white/10', 'text-white');\
          navBtn.classList.remove('text-zinc-400');\
        \} else \{\
          pageEl.classList.add('hidden');\
          navBtn.classList.remove('bg-white/10', 'text-white');\
          navBtn.classList.add('text-zinc-400');\
        \}\
      \});\
      lucide.createIcons();\
    \}\
\
    // Modal & API Key Management\
    function toggleApiKeyModal() \{\
      const modal = document.getElementById('api-modal');\
      modal.classList.toggle('hidden');\
    \}\
\
    function checkApiKey() \{\
      const key = localStorage.getItem('moodmate_gemini_key') || localStorage.getItem('haven_gemini_key');\
      const dot = document.getElementById('api-status-dot');\
      const text = document.getElementById('api-status-text');\
      const keyInput = document.getElementById('api-key-input');\
\
      if (key && key.trim().length > 0) \{\
        dot.className = "w-2 h-2 rounded-full bg-emerald-400";\
        text.innerText = "Gemini Key Connected";\
        keyInput.value = key;\
        return true;\
      \} else \{\
        dot.className = "w-2 h-2 rounded-full bg-red-400";\
        text.innerText = "No Gemini API key added";\
        return false;\
      \}\
    \}\
\
    function saveApiKey() \{\
      const input = document.getElementById('api-key-input').value.trim();\
      if (input) \{\
        localStorage.setItem('moodmate_gemini_key', input);\
        checkApiKey();\
        toggleApiKeyModal();\
      \}\
    \}\
\
    // Chat Mechanics\
    function sendQuickPrompt(text) \{\
      document.getElementById('user-input').value = text;\
      sendMessage();\
    \}\
\
    async function sendMessage() \{\
      const userInput = document.getElementById('user-input');\
      const prompt = userInput.value.trim();\
      const apiKey = localStorage.getItem('moodmate_gemini_key') || localStorage.getItem('haven_gemini_key');\
\
      if (!prompt) return;\
\
      if (!apiKey) \{\
        toggleApiKeyModal();\
        return;\
      \}\
\
      // Append User Message to UI\
      appendMessage('user', prompt);\
      userInput.value = '';\
      \
      // Add to context history\
      conversationHistory.push(\{\
        role: "user",\
        parts: [\{ text: prompt \}]\
      \});\
\
      // Show typing indicator\
      const typingId = showTypingIndicator();\
\
      try \{\
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=$\{apiKey\}`, \{\
          method: 'POST',\
          headers: \{ 'Content-Type': 'application/json' \},\
          body: JSON.stringify(\{\
            systemInstruction: \{\
              parts: [\{ text: SYSTEM_PERSONA \}]\
            \},\
            contents: conversationHistory,\
            generationConfig: \{\
              temperature: 0.85,\
              maxOutputTokens: 650\
            \}\
          \})\
        \});\
\
        const data = await response.json();\
        removeTypingIndicator(typingId);\
\
        if (data.error) \{\
          throw new Error(data.error.message || "Failed to generate response.");\
        \}\
\
        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "I'm listening, and I'm right here with you.";\
        \
        // Add to history and UI\
        conversationHistory.push(\{\
          role: "model",\
          parts: [\{ text: reply \}]\
        \});\
        appendMessage('model', reply);\
\
      \} catch (err) \{\
        removeTypingIndicator(typingId);\
        appendMessage('model', `I'm having trouble connecting right now ($\{err.message\}). Please ensure your Gemini API key is valid.`);\
      \}\
    \}\
\
    function appendMessage(sender, text) \{\
      const chatMessages = document.getElementById('chat-messages');\
      const msgDiv = document.createElement('div');\
      \
      if (sender === 'user') \{\
        msgDiv.className = "flex items-start justify-end gap-3";\
        msgDiv.innerHTML = `\
          <div class="glass-card bg-purple-500/10 border-purple-500/20 p-4 rounded-2xl rounded-tr-sm max-w-xl text-zinc-100 text-sm leading-relaxed">\
            $\{escapeHtml(text)\}\
          </div>\
          <div class="w-7 h-7 rounded-full bg-white/10 border border-white/20 flex items-center justify-center flex-shrink-0 text-zinc-300 text-xs">You</div>\
        `;\
      \} else \{\
        msgDiv.className = "flex items-start gap-3";\
        msgDiv.innerHTML = `\
          <div class="w-7 h-7 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center flex-shrink-0 text-purple-300 text-xs font-medium">M</div>\
          <div class="glass-card p-4 rounded-2xl rounded-tl-sm max-w-xl text-zinc-200 text-sm leading-relaxed border border-white/5">\
            $\{formatMoodMateResponse(text)\}\
          </div>\
        `;\
      \}\
      chatMessages.appendChild(msgDiv);\
      chatMessages.scrollTop = chatMessages.scrollHeight;\
    \}\
\
    function showTypingIndicator() \{\
      const chatMessages = document.getElementById('chat-messages');\
      const typingDiv = document.createElement('div');\
      const id = 'typing-' + Date.now();\
      typingDiv.id = id;\
      typingDiv.className = "flex items-start gap-3";\
      typingDiv.innerHTML = `\
        <div class="w-7 h-7 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center flex-shrink-0 text-purple-300 text-xs font-medium">M</div>\
        <div class="glass-card px-4 py-3 rounded-2xl rounded-tl-sm text-zinc-400 text-xs flex items-center gap-1.5 border border-white/5">\
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>\
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>\
          <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>\
          <span class="ml-1 text-zinc-500">listening gently...</span>\
        </div>\
      `;\
      chatMessages.appendChild(typingDiv);\
      chatMessages.scrollTop = chatMessages.scrollHeight;\
      return id;\
    \}\
\
    function removeTypingIndicator(id) \{\
      const el = document.getElementById(id);\
      if (el) el.remove();\
    \}\
\
    function clearChat() \{\
      conversationHistory = [];\
      const chatMessages = document.getElementById('chat-messages');\
      chatMessages.innerHTML = `\
        <div class="flex items-start gap-3">\
          <div class="w-7 h-7 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center flex-shrink-0 text-purple-300 text-xs font-medium">M</div>\
          <div class="glass-card p-4 rounded-2xl rounded-tl-sm max-w-xl text-zinc-200 text-sm leading-relaxed border border-white/5">\
            The slate is clean. Whenever you are ready, I'm right here.\
          </div>\
        </div>\
      `;\
    \}\
\
    // Helper functions\
    function escapeHtml(str) \{\
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;").replace(/\\n/g, '<br/>');\
    \}\
\
    function formatMoodMateResponse(str) \{\
      return escapeHtml(str).replace(/(?:\\r\\n|\\r|\\n)/g, '<br class="my-1.5"/>');\
    \}\
\
    // Event listener for Enter Key\
    document.getElementById('user-input').addEventListener('keydown', (e) => \{\
      if (e.key === 'Enter' && !e.shiftKey) \{\
        e.preventDefault();\
        sendMessage();\
      \}\
    \});\
\
    // Check key on boot\
    checkApiKey();\
  </script>\
